# Copy to .env and fill in (do not commit .env)

# --- Data prep (Datasets/generate_profile.py) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LM_MODEL=gpt-4o-mini
LAMP_INPUT_FILE=/path/to/train_questions.json
BATCH_SIZE=20
MAX_PAPERS=50

# --- LLM Judge (Eval/llm_judge_eval.py) ---
# Uses the same OPENAI_API_KEY / OPENAI_BASE_URL

# --- Evaluation (Eval/eval_profile_steer.py) ---
# Optional: point to LlamaFactory src if not using bundled copy
# LLAMAFACTORY_SRC=/path/to/PersonaSteer/LlamaFactory/src
# Optional: only if using --golds_file without per-row output (see LongLaMP-Benchmark/eval/evaluation.py)
# LONGLAMP_BENCHMARK_ROOT=/path/to/LongLaMP-Benchmark
